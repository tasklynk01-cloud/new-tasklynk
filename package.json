  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 5000",
    "dev:turbo": "next dev --turbo -H 0.0.0.0 -p 5000",
    "dev:clean": "rm -rf .next && next dev -H 0.0.0.0 -p 5000",
    "prebuild": "node scripts/generate-alex-catalogue.js",
    "build": "next build --webpack",
    "build:render": "npm install --legacy-peer-deps && next build --webpack",
    "start": "next start -H 0.0.0.0 -p ${PORT:-10000}",
    "start:render": "next start -H 0.0.0.0 -p ${PORT:-10000}",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:smoke": "playwright test --project=public --project=admin --project=manager --project=client --project=freelancer",
    "test:smoke:public": "playwright test --project=public",
    "test:smoke:admin": "playwright test --project=admin",
    "test:smoke:manager": "playwright test --project=manager",
    "test:smoke:client": "playwright test --project=client",
    "test:smoke:freelancer": "playwright test --project=freelancer",
    "test:smoke:editor": "playwright test --project=editor",
    "test:report": "playwright show-report",
    "playwright:install": "playwright install --with-deps chromium",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/database-migration-runner.ts",
    "db:verify": "tsx scripts/verify-database-schema.ts",
    "db:backup": "tsx scripts/backup-database.ts",
