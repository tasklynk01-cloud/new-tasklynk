# Cloudflare Pages Ignore File
# Files and directories to exclude from deployment

# Documentation (not needed in production)
*.md
docs/
.github/

# Development files
.vscode/
.idea/
*.log
*.logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
__tests__/
test/
tests/
*.test.js
*.test.ts
*.spec.js
*.spec.ts
coverage/
.nyc_output/

# Scripts (not needed in production)
scripts/
*.sh
*.bat

# Environment files (security)
.env.local
.env.development
.env.test
.env*.local

# Build cache
.next/cache/
.turbo/
node_modules/.cache/

# Temporary files
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git
.git/
.gitignore
.gitattributes

# IDE
*.sublime-project
*.sublime-workspace

# Backup files
*.backup
*.bak
back/

# Audit files
audit*.js
audit*.txt
check-*.js
activate-*.js
approve-*.js
