{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Run Next.js dev (port 5000)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "env": {
        "PORT": "5000"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "listening on.*(https?://(?:localhost|127.0.0.1):?5000)",
        "uriFormat": "%s",
        "action": "openExternally"
      },
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "pwa-node",
      "request": "attach",
      "name": "Attach to Next.js dev server",
      "processId": "${command:PickProcess}",
      "cwd": "${workspaceFolder}",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "type": "pwa-msedge",
      "request": "launch",
      "name": "Open site in Edge (5000)",
      "url": "http://localhost:5000",
      "webRoot": "${workspaceFolder}",
      "presentation": {
        "hidden": false
      }
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Open site in Chrome (5000)",
      "url": "http://localhost:5000",
      "webRoot": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Dev + Edge",
      "configurations": ["Run Next.js dev (port 5000)", "Open site in Edge (5000)"]
    },
    {
      "name": "Dev + Chrome",
      "configurations": ["Run Next.js dev (port 5000)", "Open site in Chrome (5000)"]
    }
  ]
}
      "type": "node",
      "request": "launch",
      "name": "Next.js Debug",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "args": ["dev"],
      "cwd": "${workspaceFolder}",
      "protocol": "inspector",
      "console": "integratedTerminal",
      "runtimeArgs": ["--inspect"]
    }
  ]
}
